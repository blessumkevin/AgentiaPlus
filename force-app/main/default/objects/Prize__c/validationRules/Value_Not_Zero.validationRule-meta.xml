<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Value_Not_Zero</fullName>
    <active>true</active>
    <description>Prevents saving a prize record if the value is zero.</description>
    <errorConditionFormula>Value__c = 0</errorConditionFormula>
    <errorDisplayField>Value__c</errorDisplayField>
    <errorMessage>Value cannot be $0.</errorMessage>
</ValidationRule>
