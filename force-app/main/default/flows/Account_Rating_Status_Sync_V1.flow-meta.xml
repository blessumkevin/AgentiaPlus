    <decisions>
        <name>Check_Rating_Value</name>
        <label>Check Rating Value</label>
        <locationX>440</locationX>
        <locationY>168</locationY>
        <defaultConnector>
            <targetReference>Assign_Default_Description</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other / No Rating</defaultConnectorLabel>
        <rules>
            <name>Is_Hot</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Rating</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Hot</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Hot_Description</targetReference>
            </connector>
            <label>Is Hot</label>
        </rules>
        <rules>
            <name>Is_Warm</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Rating</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Warm</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Warm_Description</targetReference>
            </connector>
            <label>Is Warm</label>
        </rules>
        <rules>
            <name>Is_Cold</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Rating</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cold</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Cold_Description</targetReference>
            </connector>
            <label>Is Cold</label>
        </rules>
    </decisions>
    <description>V1 - Syncs Account Description based on Rating changes. Used for demo conflict resolution.</description>
    <label>Account Rating Status Sync V1</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Account_Description</name>
        <label>Update Account Description</label>
        <locationX>440</locationX>
        <locationY>408</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>$Record.Description</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>440</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Check_Rating_Value</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Rating</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
