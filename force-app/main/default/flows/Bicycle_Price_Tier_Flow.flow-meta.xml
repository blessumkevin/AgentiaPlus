<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Price_Tier</name>
        <label>Check Price Tier</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <defaultConnector>
            <targetReference>Update_Tier_1</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Tier 1 ($1000+)</defaultConnectorLabel>
        <rules>
            <name>Is_Tier_3</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Price__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>500.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Tier_3</targetReference>
            </connector>
            <label>Is Tier 3 (Under $500)</label>
        </rules>
        <rules>
            <name>Is_Tier_2</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Price__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>500.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Price__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>1000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Tier_2</targetReference>
            </connector>
            <label>Is Tier 2 ($500 - $999)</label>
        </rules>
    </decisions>
    <label>Bicycle Price Tier Flow</label>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Tier_1</name>
        <label>Set Price Tier to Tier 1</label>
        <locationX>352</locationX>
        <locationY>400</locationY>
        <inputAssignments>
            <field>Price_Tier__c</field>
            <value>
                <stringValue>Tier 1</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Tier_2</name>
        <label>Set Price Tier to Tier 2</label>
        <locationX>176</locationX>
        <locationY>400</locationY>
        <inputAssignments>
            <field>Price_Tier__c</field>
            <value>
                <stringValue>Tier 2</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Tier_3</name>
        <label>Set Price Tier to Tier 3</label>
        <locationX>0</locationX>
        <locationY>400</locationY>
        <inputAssignments>
            <field>Price_Tier__c</field>
            <value>
                <stringValue>Tier 3</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>176</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Check_Price_Tier</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Price__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Bicycle__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
